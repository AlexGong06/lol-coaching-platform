# Copy this to .env (gitignored) and `npm run migrate` / `npm run test:db` will read it:
#   cp .env.example .env
# A DATABASE_URL already set in the shell or in CI wins over this file.
#
# Any PostgreSQL 16+. Docker is one option, not a requirement.
#   docker compose up -d db
#   brew install postgresql@16 && brew services start postgresql@16
#
# Note for this dev machine (macOS 14): Homebrew no longer ships bottles for it, so the
# brew line above builds postgresql, icu4c, openssl and krb5 from source. Use Docker here.
DATABASE_URL=postgres://coaching:coaching@localhost:5432/coaching
