# Copy this to .env (gitignored) and `npm run migrate` / `npm run test:db` will read it:
#   cp .env.example .env
# A DATABASE_URL already set in the shell or in CI wins over this file.
#
# Any PostgreSQL 16+. Docker is one option, not a requirement.
#   docker compose up -d db
#   brew install postgresql@16 && brew services start postgresql@16
#
# Note for this dev machine (macOS 14): Homebrew no longer ships bottles for it, so the
# brew line above builds postgresql, icu4c, openssl and krb5 from source. Use Docker here.
DATABASE_URL=postgres://coaching:coaching@localhost:5432/coaching

# ---------------------------------------------------------------------- Stripe
# Test mode only. dashboard.stripe.com/test/apikeys -> Secret key. Test mode works as
# soon as the account's email is confirmed; activation is only needed for real payouts.
STRIPE_SECRET_KEY=sk_test_...

# Printed by `stripe listen`, whose exact command `npm run dev` prints on startup. The
# CLI refuses to run without --events, --all-snapshot or --all-thin:
#   stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded \
#     --forward-to localhost:3000/api/stripe/webhook
#
# This secret is stable: it belongs to the CLI's device pairing, not to a run, so paste it
# once. It changes on `stripe login`/`logout`, a different sandbox, or another machine, and
# `stripe listen --print-secret` reprints it. It is NOT a dashboard endpoint's secret.
# The CLI is how a webhook reaches a laptop at all: Stripe cannot POST to localhost.
STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe returns the student. These pages do not exist yet.
STRIPE_SUCCESS_URL=http://localhost:3000/booking/success
STRIPE_CANCEL_URL=http://localhost:3000/booking/cancelled
