{
  "name": "lol-coaching-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "test:unit": "node --test --experimental-strip-types \"test/unit/*.test.ts\"",
    "test:db": "node --test --experimental-strip-types \"test/db/*.test.ts\"",
    "test": "npm run test:unit && npm run test:db",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "typescript": "5.9.2"
  }
}
